@model StudentManagementSystem.Models.Student
<form asp-action="Edit" method="post">

                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="Id" />

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label fw-semibold">Name</label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EmailId" class="form-label fw-semibold">Email</label>
                        <input asp-for="EmailId" class="form-control" />
                        <span asp-validation-for="EmailId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Age" class="form-label fw-semibold">Age</label>
                        <input asp-for="Age" class="form-control" />
                        <span asp-validation-for="Age" class="text-danger"></span>
                    </div>

        <div class="col-md-4">
            <label asp-for="DepartmentId" class="form-label"></label>
            <select asp-for="DepartmentId" class="form-select" asp-items="@(ViewBag.Departments as SelectList)">
                <option value="">-- Select Department --</option>
            </select>
            <span asp-validation-for="DepartmentId" class="text-danger"></span>
        </div>

        <div class="col-md-4">
            <label asp-for="CourseId" class="form-label"></label>
            <select asp-for="CourseId" class="form-select" asp-items="@(ViewBag.Courses as SelectList)" data-selected="@Model.CourseId">
                <option value="">-- Select Course --</option>
            </select>
            <span asp-validation-for="CourseId" class="text-danger"></span>
        </div>

                    <div class="col-md-6">
                        <label asp-for="CourseStartDate" class="form-label fw-semibold">Start Date</label>
                        <input asp-for="CourseStartDate" type="date" class="form-control" />
                        <span asp-validation-for="CourseStartDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CourseEndDate" class="form-label fw-semibold">End Date</label>
                        <input asp-for="CourseEndDate" type="date" class="form-control" />
                        <span asp-validation-for="CourseEndDate" class="text-danger"></span>
                    </div>

    </div>
    <div class="col-md-4">
        <label asp-for="CourseId" class="form-label"></label>
        <select asp-for="CourseId" class="form-select" asp-items="@(ViewBag.Courses as SelectList)" data-selected="@Model.CourseId">
            <option value="">-- Select Course --</option>
        </select>
        <span asp-validation-for="CourseId" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="CourseStartDate" class="form-label"></label>
        <input asp-for="CourseStartDate" type="date" class="form-control" />
    </div>

    <div class="col-md-6">
        <label asp-for="CourseEndDate" class="form-label"></label>
        <input asp-for="CourseEndDate" type="date" class="form-control" />
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deptSelect = document.querySelector('select[name="DepartmentId"]');
            var courseSelect = document.querySelector('select[name="CourseId"]');

            function getProp(obj, names) {
                for (var i = 0; i < names.length; i++) {
                    if (obj[names[i]] !== undefined && obj[names[i]] !== null) return obj[names[i]];
                }
                return undefined;
            }

            function loadCourses(deptId, selectedId) {
                courseSelect.innerHTML = '<option value="">-- Select Course --</option>';
                if (!deptId) return;

                var url = '@Url.Action("GetByDepartment", "Course")' + '?id=' + encodeURIComponent(deptId);
                console.log('loading courses from', url);

                fetch(url)
                    .then(function (res) { return res.text(); })
                    .then(function (text) {
                        try {
                            var data = JSON.parse(text);
                        } catch (e) {
                            console.error('Invalid JSON response for courses:', text);
                            return [];
                        }

                        if (!Array.isArray(data)) data = [];
                        console.log('courses returned', data);

                        data.forEach(function (c) {
                            var opt = document.createElement('option');
                            var id = getProp(c, ['Id', 'id', 'ID']);
                            var name = getProp(c, ['CourseName', 'courseName', 'Name', 'name']);
                            opt.value = id !== undefined ? id : '';
                            opt.text = name !== undefined ? name : (id !== undefined ? id : '');
                            if (selectedId && String(selectedId) === String(id)) opt.selected = true;
                            courseSelect.appendChild(opt);
                        });
                    })
                    .catch(function (err) { console.error('fetch error', err); });
            }

            if (deptSelect) {
                deptSelect.addEventListener('change', function () { loadCourses(this.value); });
                // load courses for current department value (for edit)
                if (deptSelect.value) {
                    var selectedCourse = courseSelect.getAttribute('data-selected');
                    loadCourses(deptSelect.value, selectedCourse);
                }
            }
        });
    </script>

                <div class="mt-4">
                    <button type="submit" class="btn btn-warning px-4 me-2">
                        Update
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}