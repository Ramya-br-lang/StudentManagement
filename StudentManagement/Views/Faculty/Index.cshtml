@model IEnumerable<StudentManagementSystem.Models.Faculty>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Faculties</h2>
    <a asp-action="Create" class="btn btn-success">+ Create Faculty</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Department</th>
            <th style="width:300px">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Department?.DepartmentName</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm me-1">Details</a>
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm me-1">Edit</a>
                    <a asp-action="AssignCourses"
                       asp-route-id="@item.Id"
                       class="btn btn-secondary btn-sm me-1">
                        Assign Courses
                    </a>
                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this faculty?');">
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
