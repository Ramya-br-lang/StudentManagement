@model StudentManagementSystem.Models.Faculty

<div class="container mt-4">

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4>Assign Courses to Faculty</h4>
        </div>

        <div class="card-body">

            <h5>
                Faculty: <strong>@Model.Name</strong>
            </h5>

            <p>
                Department:
                <strong>@Model.Department?.DepartmentName</strong>
            </p>

            <hr />

            <form asp-action="AssignCourses" method="post">

                <input type="hidden" name="id" value="@Model.Id" />

                <div class="mb-3">
                    <label class="form-label fw-bold">
                        Select Courses
                    </label>

                    <select name="selectedCourseIds"
                            asp-items="ViewBag.Courses"
                            multiple
                            class="form-control"
                            size="8">
                    </select>

                    <small class="text-muted">
                        Hold CTRL to select multiple courses
                    </small>
                </div>

                <button type="submit" class="btn btn-success">
                    Save Assignments
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>